{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": ".",
    "outDir": "dist-core",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/mechanical-schema/src/**/*.ts",
    "packages/mechanical-core/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-core"
  ]
}
