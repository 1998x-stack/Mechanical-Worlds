{
  "name": "mechanical-worlds",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run assets:validate && npm run assets:stage && npm run assets:contracts && tsc -p tsconfig.web.json && vite build",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "check": "npm run skills:check && npm run assets:validate && npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "skills:sync": "node tools/skills/sync.mjs sync",
    "skills:check": "node tools/skills/sync.mjs check",
    "assets:build": "node tools/asset-pipeline/generate-automotive.mjs && node tools/asset-pipeline/generate-powertrain.mjs",
    "assets:validate": "node tools/asset-pipeline/validate-glb.mjs --report && node tools/asset-pipeline/validate-powertrain.mjs --report",
    "assets:stage": "node tools/asset-pipeline/stage-assets.mjs",
    "predev": "npm run assets:stage",
    "assets:plan": "node tools/asset-pipeline/plan-next-batch.mjs",
    "assets:contracts": "npm run build:core && node tools/asset-pipeline/export-contracts.mjs && node tools/asset-pipeline/audit-engine-i4.mjs && node tools/asset-pipeline/audit-engine-clearance.mjs",
    "engine:audit": "npm run build:core && node tools/asset-pipeline/audit-engine-i4.mjs",
    "engine:clearance": "npm run build:core && node tools/asset-pipeline/audit-engine-clearance.mjs",
    "cad:build": "python tools/cad/generate_engine_reference.py --output dist-cad/engine-i4",
    "cad:mesh-audit": "npm run build:core && node tools/cad/audit_cad_mesh.mjs --step-deg=180"
  },
  "dependencies": {
    "three": "^0.181.2",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
